{
  "schema": "line-manifest/v1",
  "line": "wanxing",
  "public_base_url": "https://wanxing.finddatatech.cloud",
  "identity": {
    "issuer": "https://auth.finddatatech.cloud/oidc",
    "jwks_uri": "https://auth.finddatatech.cloud/oidc/jwks",
    "jit_policy": "off"
  },
  "auth_tracks": [
    {
      "kind": "customer-key",
      "name": "ciyuan-caller-key",
      "accepts": "ciyuan-sk",
      "fallback": true,
      "enforced": true
    }
  ],
  "scopes": [
    "line:read",
    "line:write"
  ],
  "billing": {
    "plane": "ciyuan"
  },
  "surfaces": {
    "mcp": true,
    "account": false,
    "admin": false
  }
}
